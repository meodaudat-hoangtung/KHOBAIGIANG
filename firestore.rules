rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isValidString(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidPresentation(data) {
      return data.keys().hasAll(['id', 'title', 'slidesJson', 'updatedAt']) &&
             data.id is string && data.id.size() > 0 && data.id.size() <= 128 &&
             isValidString(data.title, 1, 300) &&
             data.slidesJson is string && data.slidesJson.size() <= 5000000 &&
             data.updatedAt is string && data.updatedAt.size() <= 64;
    }

    function isValidAppState(data) {
      return data.keys().hasAll(['activePresentationId', 'updatedAt']) &&
             data.activePresentationId is string && data.activePresentationId.size() <= 128 &&
             data.updatedAt is string && data.updatedAt.size() <= 64 &&
             (!('deletedLibraryIds' in data) || data.deletedLibraryIds is list);
    }

    match /presentations/{presentationId} {
      allow read: if true;
      allow create, update: if isValidId(presentationId) && isValidPresentation(request.resource.data);
      allow delete: if isValidId(presentationId);
    }

    match /system/{systemDocId} {
      allow read: if true;
      allow create, update: if isValidId(systemDocId) && isValidAppState(request.resource.data);
      allow delete: if false;
    }
  }
}
